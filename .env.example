# Copy this file to .env and adjust the values for your installation.
# Never commit the real .env file.

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Shop identity ----------------------------------------------------------
NASS_SHOP_NAME=My Shop

# --- Server database --------------------------------------------------------
# Leave DJANGO_DB_ENGINE empty to use the bundled SQLite database.
# Supported values: mysql, postgres
DJANGO_DB_ENGINE=
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=

# --- First-run admin bootstrap (server) -------------------------------------
NASS_BOOTSTRAP_ADMIN_USERNAME=admin
NASS_BOOTSTRAP_ADMIN_PASSWORD=change-me
NASS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --- Desktop build profiles -------------------------------------------------
# The frozen build connects to this server by default.
NASS_PRODUCTION_SERVER_URL=https://your-server.example.com
# Comma-separated extra hosts that also count as production (optional).
NASS_PRODUCTION_HOSTS=
# The source checkout refuses to connect to the production host; point it here.
NASS_DEV_SERVER_URL=http://127.0.0.1:8000
